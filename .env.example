DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
REDIS_URL=rediss://:[password]@[endpoint].upstash.io:6379
ALCHEMY_API_KEY=
HELIUS_API_KEY=
HELIUS_WEBHOOK_SECRET=
SENTRY_DSN=
RUST_LOG=info

# Cold-start block for the EVM indexer. Only used the first time a chain is
# indexed — once a cursor exists in chain_cursors it takes precedence, so
# restarts resume where they left off. Unset means start at the current tip
# and index no history.
EVM_START_BLOCK=

# How often each chain re-scans from its cursor to the tip to pick up anything
# the live subscription missed. Defaults to 30s; clamped to a 1s minimum.
EVM_RECONCILE_INTERVAL_SECS=30
